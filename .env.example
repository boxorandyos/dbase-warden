# Control plane
HOST=0.0.0.0
PORT=3101
DBASE_DB_PATH=./data/dbase.sqlite
DBASE_JWT_SECRET=replace-with-a-long-random-secret
DBASE_ADMIN_USERNAME=admin
DBASE_ADMIN_PASSWORD=replace-with-at-least-8-characters
CORS_ORIGIN=http://localhost:8188
DBASE_BACKUP_DIR=./data/backups
DBASE_ALLOW_PROCESS_CONTROL=0
# Host product and package updates run only when this is 1. The API still records the planned command when it is 0.
DBASE_ALLOW_HOST_UPDATE=0
# master triggers registered slaves. A slave accepts POST /api/v1/maintenance/apply when the key matches.
DBASE_NODE_ROLE=master
DBASE_MAINTENANCE_KEY=

# Web console dev server proxies /api to the control plane.
# VITE_API_URL is optional; leave unset to use same-origin /api.
