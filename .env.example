# Control plane
HOST=0.0.0.0
PORT=3101
DBASE_DB_PATH=./data/dbase.sqlite
DBASE_JWT_SECRET=replace-with-a-long-random-secret
DBASE_ADMIN_USERNAME=admin
DBASE_ADMIN_PASSWORD=replace-with-at-least-8-characters
CORS_ORIGIN=http://localhost:8188

# Web console dev server proxies /api to the control plane.
# VITE_API_URL is optional; leave unset to use same-origin /api.
